# Enforce uniform LF line endings on all source and JSON data files
# so SHA-256 manifest verification never breaks across Windows/macOS/Linux git clones.
* text=auto eol=lf

*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.command text eol=lf
SHA256SUMS text eol=lf

# Windows batch scripts require CRLF
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.sqlite3 binary
